<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared debug launch configuration for handler DLL projects.
  Configures F5 (Start Debugging) to launch Explorer under the debugger
  so breakpoints in in-process COM handler DLLs are hit.

  Workflow: Kill Explorer → F5 on handler DLL project → Explorer launches
  under debugger → browse to .xisf file → breakpoints hit in DLL code.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LocalDebuggerCommand>$(SystemRoot)\explorer.exe</LocalDebuggerCommand>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
</Project>
