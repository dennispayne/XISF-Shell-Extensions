<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain hardening for NuGet (Level 3).

    1. <packageSources> is cleared and only nuget.org is allowed. This
       defends against feed-confusion / dependency-substitution attacks
       (e.g., an internal feed tricked into resolving to a malicious feed).

    2. <packageSourceMapping> forces every package to be fetched from
       nuget.org. Even if a developer adds another source locally, no
       package can come from it.

    3. <config signatureValidationMode="require" /> rejects any package
       whose signature does not chain to a trusted signer below.

    4. <trustedSigners> trusts the nuget.org repository signature. NuGet
       counter-signs every package it accepts, so this catches packages
       that were not published through nuget.org's pipeline (e.g.,
       arbitrary blob substitution).

       The <owners> list pins which nuget.org publisher accounts may
       supply our packages. If a transitive dependency is owned by an
       account not listed, restore fails with a clear error and you can
       extend the list (after verifying the new owner is legitimate).

    Rotation: NuGet rotates its repository signing certificate
    periodically. If restore starts failing with NU3018 / NU3037 after
    a successful run, update the <certificate fingerprint="..."> below.
    Current fingerprints are documented at:
      https://learn.microsoft.com/en-us/nuget/reference/nuget-config-file#trustedsigners-section
      https://www.nuget.org/policies/Security
    Both historically valid fingerprints are listed; NuGet accepts a
    match against any <certificate> child.

    To downgrade temporarily (e.g., to debug a sig issue), comment out
    <config>signatureValidationMode</config> and the <trustedSigners>
    block - restore will fall back to "accept" mode.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <!-- Original nuget.org repository signing cert (pre-2021 rotation) -->
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <!-- 2021-2024 rotation cert -->
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <!-- 2024+ current cert (used to sign WiX 5.0.2 and other recent packages) -->
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <owners>microsoft;wixtoolset;aarnott;nuget;dotnetfoundation;aspnet</owners>
    </repository>
  </trustedSigners>
</configuration>
