// XISFPreviewHandler.rc - Version info
#include <windows.h>
/////////////////////////////////////////////////////////////////////////////
// Version info - populated from build/version.props via preprocessor defines
// XISF_VERSION_STR and XISF_VERSION_COMMA.
#ifndef XISF_VERSION_COMMA
#define XISF_VERSION_COMMA 0,1,0,0
#endif
#ifndef XISF_VERSION_TEXT
#define XISF_VERSION_TEXT 0.1.0.0
#endif
#define XISF_STR_(x) #x
#define XISF_STR(x) XISF_STR_(x)
#define XISF_VERSION_STR XISF_STR(XISF_VERSION_TEXT)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    XISF_VERSION_COMMA
 PRODUCTVERSION XISF_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Dennis Payne"
            VALUE "FileDescription",  "XISF Preview and Thumbnail Handler"
            VALUE "FileVersion",      XISF_VERSION_STR
            VALUE "InternalName",     "XISFPreviewHandler"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Dennis Payne. MIT License."
            VALUE "OriginalFilename", "XISFPreviewHandler.dll"
            VALUE "ProductName",      "XISF Shell Extension"
            VALUE "ProductVersion",   XISF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END