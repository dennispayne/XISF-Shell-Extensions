<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Don't inherit C++ output paths from Directory.Build.targets -->
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <!-- Supply-chain hardening: pin transitive package versions + hashes via packages.lock.json -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Support multiple runtime identifiers for cross-platform builds -->
    <RuntimeIdentifiers>win;win-arm64;win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <!-- If caller passed /p:XISFVersion=..., honor it. Otherwise prefer
         NB.GV's $(BuildVersionSimple), and finally fall back to a default. -->
    <ProductVersion Condition="'$(XISFVersion)' != ''">$(XISFVersion)</ProductVersion>
    <ProductVersion Condition="'$(ProductVersion)' == '' and '$(BuildVersionSimple)' != ''">$(BuildVersionSimple)</ProductVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Point to build output; CI or local builds place binaries here -->
    <BinDir Condition="'$(BinDir)' == ''">$(MSBuildThisFileDirectory)..\..\x64\Release\</BinDir>
    <DataDir Condition="'$(DataDir)' == ''">$(MSBuildThisFileDirectory)..\..\data\</DataDir>
    <PropdescDir Condition="'$(PropdescDir)' == ''">$(MSBuildThisFileDirectory)..\..\PropertyHandler\XISFPropertyHandler\propdesc\</PropdescDir>
    <DefineConstants>$(DefineConstants);BinDir=$(BinDir);DataDir=$(DataDir);PropdescDir=$(PropdescDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="BinDir" Path="$(BinDir)" />
    <BindPath Include="DataDir" Path="$(DataDir)" />
    <BindPath Include="PropdescDir" Path="$(PropdescDir)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PropertyHandler\XISFPropertyHandler\XISFPropertyHandler.vcxproj" />
    <ProjectReference Include="..\..\PreviewHandler\XISFPreviewHandler\XISFPreviewHandler.vcxproj" />
    <ProjectReference Include="..\..\Filter\XISFFilter\XISFFilter.vcxproj" />
    <ProjectReference Include="..\..\ShellExtensionHost\ShellExtensionHost\ShellExtensionHost.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ── License (EULA) ──
       The LicenseAgreementDlg shown by WixUI_FeatureTree consumes
       License.rtf via the WixUILicenseRtf variable. Regenerate it
       from the canonical repo LICENSE on every build so the two
       never drift. The script is incremental (no-op when content
       matches), so this stays cheap on warm rebuilds. -->
  <ItemGroup>
    <None Include="License.rtf" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE">
      <Link>LICENSE</Link>
    </None>
  </ItemGroup>

  <Target Name="RegenerateLicenseRtf"
          BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildThisFileDirectory)..\..\LICENSE;$(MSBuildThisFileDirectory)..\..\scripts\Convert-LicenseToRtf.ps1"
          Outputs="$(MSBuildThisFileDirectory)License.rtf">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Convert-LicenseToRtf.ps1&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
  </Target>
</Project>
