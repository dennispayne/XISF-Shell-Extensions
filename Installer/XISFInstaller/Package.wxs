<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    XISF Shell Extensions MSI installer.
    Installs all three handler DLLs, the settings app, and the propdesc schema.
    COM registration is done via regsvr32 custom actions (deferred/elevated)
    because the DLLs' DllRegisterServer handles complex shared state
    (file associations, SystemFileAssociations, propdesc, ProgIDs).

    Runtime handler enable/disable is managed by the settings app via HKCU flags,
    not by MSI features. All handlers are always installed.
  -->

  <Package
      Name="XISF Shell Extensions"
      Manufacturer="Dennis Payne"
      Version="$(var.ProductVersion)"
      UpgradeCode="E8A1B2C3-D4E5-6F78-9A0B-1C2D3E4F5A6B"
      Scope="perMachine"
      Language="1033"
      Codepage="1252">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- ── Install directory ── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="XISF Shell Extensions">
      </Directory>
    </StandardDirectory>

    <!-- ── Program Menu shortcut ── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="XISF Shell Extensions">
      </Directory>
    </StandardDirectory>

    <!-- ── Components ── -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <Component Id="PropertyHandlerDll" Bitness="always64">
        <File Id="XISFPropertyHandler.dll" Source="$(var.BinDir)XISFPropertyHandler.dll" KeyPath="yes" />
      </Component>

      <Component Id="PreviewHandlerDll" Bitness="always64">
        <File Id="XISFPreviewHandler.dll" Source="$(var.BinDir)XISFPreviewHandler.dll" KeyPath="yes" />
      </Component>

      <Component Id="FilterDll" Bitness="always64">
        <File Id="XISFFilter.dll" Source="$(var.BinDir)XISFFilter.dll" KeyPath="yes" />
      </Component>

      <Component Id="SettingsApp" Bitness="always64">
        <File Id="XISFShellExtensionHost.exe" Source="$(var.BinDir)XISFShellExtensionHost.exe" KeyPath="yes" />
      </Component>

      <Component Id="PropdescSchema" Bitness="always64">
        <File Id="xisf.propdesc" Source="$(var.PropdescDir)xisf.propdesc" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- ── Start Menu shortcut ── -->
    <ComponentGroup Id="ShortcutComponents" Directory="ProgramMenuDir">
      <Component Id="SettingsShortcut" Bitness="always64">
        <Shortcut Id="SettingsAppShortcut"
                  Name="XISF Shell Extension Settings"
                  Target="[INSTALLFOLDER]XISFShellExtensionHost.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Configure XISF property, preview, and search handlers" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DennisPayne\XISF Shell Extension\MSI"
                       Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── Single feature: everything ── -->
    <Feature Id="Complete" Title="XISF Shell Extensions" Level="1"
             Description="Property handler, preview/thumbnail handler, search filter, and settings app."
             ConfigurableDirectory="INSTALLFOLDER"
             AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!-- ════════════════════════════════════════════════════════════════════
         Custom Actions — COM registration via regsvr32
         Each DLL gets its own register/unregister CA so failures are isolated.
         Uses WixQuietExec64 from WixToolset.Util.wixext.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Register: property handler -->
    <SetProperty Id="CA_RegisterProperty" Value="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]XISFPropertyHandler.dll&quot;"
                 Before="CA_RegisterProperty" Sequence="execute" Condition="NOT REMOVE" />
    <CustomAction Id="CA_RegisterProperty" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred" Return="check" Impersonate="no" />

    <!-- Register: preview handler -->
    <SetProperty Id="CA_RegisterPreview" Value="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]XISFPreviewHandler.dll&quot;"
                 Before="CA_RegisterPreview" Sequence="execute" Condition="NOT REMOVE" />
    <CustomAction Id="CA_RegisterPreview" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred" Return="check" Impersonate="no" />

    <!-- Register: search filter -->
    <SetProperty Id="CA_RegisterFilter" Value="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]XISFFilter.dll&quot;"
                 Before="CA_RegisterFilter" Sequence="execute" Condition="NOT REMOVE" />
    <CustomAction Id="CA_RegisterFilter" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred" Return="check" Impersonate="no" />

    <!-- Unregister: property handler -->
    <SetProperty Id="CA_UnregisterProperty" Value="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]XISFPropertyHandler.dll&quot;"
                 Before="CA_UnregisterProperty" Sequence="execute" Condition="REMOVE" />
    <CustomAction Id="CA_UnregisterProperty" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Unregister: preview handler -->
    <SetProperty Id="CA_UnregisterPreview" Value="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]XISFPreviewHandler.dll&quot;"
                 Before="CA_UnregisterPreview" Sequence="execute" Condition="REMOVE" />
    <CustomAction Id="CA_UnregisterPreview" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Unregister: search filter -->
    <SetProperty Id="CA_UnregisterFilter" Value="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]XISFFilter.dll&quot;"
                 Before="CA_UnregisterFilter" Sequence="execute" Condition="REMOVE" />
    <CustomAction Id="CA_UnregisterFilter" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Schedule custom actions -->
    <InstallExecuteSequence>
      <Custom Action="CA_UnregisterFilter"   Before="CA_UnregisterPreview"  Condition="REMOVE" />
      <Custom Action="CA_UnregisterPreview"  Before="CA_UnregisterProperty" Condition="REMOVE" />
      <Custom Action="CA_UnregisterProperty" Before="RemoveFiles"           Condition="REMOVE" />

      <Custom Action="CA_RegisterProperty" After="InstallFiles"          Condition="NOT REMOVE" />
      <Custom Action="CA_RegisterPreview"  After="CA_RegisterProperty"   Condition="NOT REMOVE" />
      <Custom Action="CA_RegisterFilter"   After="CA_RegisterPreview"    Condition="NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
