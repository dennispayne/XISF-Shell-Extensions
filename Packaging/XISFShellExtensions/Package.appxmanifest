<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the XISF Shell Extension.

  Contents:
    * XISFPropertyHandler.dll  (Details pane / Search metadata)
    * XISFPreviewHandler.dll   (Preview pane + Explorer thumbnails)
    * XISFShellExtensionHost.exe (settings app: enable/disable each handler,
                                  install/verify OpenNGC catalogs)

  Both handlers are always installed. Users control which are active at
  runtime via HKCU\Software\DennisPayne\XISF Shell Extension\{PropertyEnabled,
  PreviewEnabled} (toggled from the settings app). Catalog files are never
  redistributed with this package; they are acquired on-demand from a pinned
  OpenNGC commit and verified by SHA-256.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    IgnorableNamespaces="uap rescap com desktop desktop2 desktop6">

  <Identity
      Name="DennisPayne.XISF.ShellExtension"
      Publisher="CN=Dennis Payne"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>XISF Shell Extension</DisplayName>
    <PublisherDisplayName>Dennis Payne</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop"
                       MinVersion="14.0.30035.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="XISFHost" Executable="XISFShellExtensionHost.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="XISF Shell Extension"
          Description="Settings for the XISF property, preview, and thumbnail handlers. Installs and verifies OpenNGC catalogs on demand."
          BackgroundColor="#1A1A2E"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="XISF Property Handler">
              <com:Class Id="7C54FA8B-9D63-4C10-8FBE-1A5A0F9A3B2E" Path="XISFPropertyHandler.dll" ThreadingModel="Both" />
              <com:Class Id="A3B7C8D9-E1F2-4A5B-8C6D-7E8F9A0B1C2D" Path="XISFPropertyHandler.dll" ThreadingModel="Both" />
            </com:SurrogateServer>
            <com:SurrogateServer DisplayName="XISF Preview / Thumbnail Handler">
              <com:Class Id="9C76E8AD-4E85-5F30-B00D-3C7D1AB5F6E0" Path="XISFPreviewHandler.dll" ThreadingModel="Both" />
              <com:Class Id="AD87F6CE-5B03-6E41-C11E-4DB2AC06F5F1" Path="XISFPreviewHandler.dll" ThreadingModel="Both" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="xisf">
            <uap:SupportedFileTypes>
              <uap:FileType>.xisf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:InfoTip>XISF Image File</uap:InfoTip>
            <desktop2:DesktopPropertyHandler Clsid="7C54FA8B-9D63-4C10-8FBE-1A5A0F9A3B2E" />
            <desktop2:DesktopPreviewHandler Clsid="AD87F6CE-5B03-6E41-C11E-4DB2AC06F5F1" />
            <desktop2:ThumbnailHandler Clsid="9C76E8AD-4E85-5F30-B00D-3C7D1AB5F6E0" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask"
                          Executable="XISFShellExtensionHost.exe"
                          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="XISFShellRegister"
                               Enabled="true"
                               DisplayName="XISF Shell Extension" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
