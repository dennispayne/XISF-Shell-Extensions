// ShellExtensionHost.rc - Version info + settings dialog
#include <windows.h>
#include <commctrl.h>
#include "HostResources.h"

#ifdef RC_INVOKED
#ifndef XISF_VERSION_COMMA
#define XISF_VERSION_COMMA 0,1,0,0
#endif
#ifndef XISF_VERSION_TEXT
#define XISF_VERSION_TEXT 0.1.0.0
#endif
#define XISF_STR_(x) #x
#define XISF_STR(x) XISF_STR_(x)
#define XISF_VERSION_STR XISF_STR(XISF_VERSION_TEXT)
#endif

IDD_SETTINGS DIALOGEX 0, 0, 500, 332
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "XISF Shell Extensions Utility"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enable or disable the Windows Shell handlers for .xisf files. Changes apply next time File Explorer loads the handler (Restart File Explorer from Task Manager to apply immediately).",
                    IDC_STATIC_INTRO,   10,  8, 480, 20
    GROUPBOX        "Handlers",                     -1,                 10, 32, 480, 70
    LTEXT           "Property Handler",              -1,                 20, 47, 78, 10
    PUSHBUTTON      "…",
                    IDC_BTN_TOGGLE_PROPERTY, 102, 44, 55, 14
    LTEXT           "✓",                IDC_STATIC_PROPERTY_STATUS, 162, 47, 10, 10
    LTEXT           "",                 IDC_STATIC_PROPERTY_VER,    175, 47, 305, 10
    LTEXT           "Preview / Thumbnail",           -1,                 20, 65, 78, 10
    PUSHBUTTON      "…",
                    IDC_BTN_TOGGLE_PREVIEW,  102, 62, 55, 14
    LTEXT           "✓",                IDC_STATIC_PREVIEW_STATUS, 162, 65, 10, 10
    LTEXT           "",                 IDC_STATIC_PREVIEW_VER,    175, 65, 305, 10

    GROUPBOX        "DSO Catalogs", IDC_STATIC_CATALOGS, 10, 108, 480, 170
    CONTROL         "", IDC_LINK_OPENNGC_COMMIT, WC_LINK,
                    WS_CHILD | WS_VISIBLE | WS_TABSTOP, 20, 120, 270, 12
    PUSHBUTTON      "Copy Hashes",
                    IDC_BTN_COPY_EXPECTED_HASHES, 294, 118, 90, 14
    CONTROL         "", IDC_LINK_HASH_HELP, WC_LINK,
                    WS_CHILD | WS_VISIBLE | WS_TABSTOP, 388, 120, 92, 12

    LTEXT           "Catalog",          -1, 20, 136, 55, 10
    LTEXT           "GitHub",           -1, 82, 136, 130, 10
    LTEXT           "Local",            -1, 218, 136, 130, 10
    LTEXT           "",                 -1, 352, 136, 10, 10

    LTEXT           "NGC.csv",          IDC_STATIC_NGC_LABEL, 20, 150, 60, 10
    LTEXT           "-",                IDC_STATIC_NGC_GITHUB, 82, 150, 130, 10
    LTEXT           "-",                IDC_STATIC_NGC_LOCAL, 218, 150, 130, 10
    LTEXT           "?",                IDC_STATIC_NGC_MATCH, 352, 150, 10, 10
    PUSHBUTTON      "Install",
                    IDC_BTN_FETCH_NGC, 370, 148, 52, 14
    PUSHBUTTON      "Remove",
                    IDC_BTN_REMOVE_NGC, 428, 148, 52, 14

    LTEXT           "addendum.csv",     IDC_STATIC_ADD_LABEL, 20, 168, 60, 10
    LTEXT           "-",                IDC_STATIC_ADD_GITHUB, 82, 168, 130, 10
    LTEXT           "-",                IDC_STATIC_ADD_LOCAL, 218, 168, 130, 10
    LTEXT           "?",                IDC_STATIC_ADD_MATCH, 352, 168, 10, 10
    PUSHBUTTON      "Install",
                    IDC_BTN_FETCH_ADD, 370, 166, 52, 14
    PUSHBUTTON      "Remove",
                    IDC_BTN_REMOVE_ADD, 428, 166, 52, 14

    CONTROL         "", IDC_PROGRESS, PROGRESS_CLASSA,
                    WS_CHILD | WS_VISIBLE,   20, 190, 460, 10
    LTEXT           "",                 IDC_STATIC_PROGRESS_TEXT, 20, 204, 460, 14

    PUSHBUTTON      "Import from File...",
                    IDC_BTN_IMPORT_FILE,  20, 222, 100, 14
    PUSHBUTTON      "Open Catalog Folder",
                    IDC_BTN_OPEN_CATALOG_DIR, 127, 222, 130, 14

    PUSHBUTTON      "Advanced",
                    IDC_BTN_ADVANCED,       360, 308, 60, 14
    DEFPUSHBUTTON   "Close",            IDOK,               430, 308,  60, 14
    LTEXT           "",                 IDC_STATIC_VERSION,  10, 310, 340, 10
END

IDD_ADVANCED DIALOGEX 0, 0, 360, 246
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Handler actions (elevated)", -1, 10, 8, 340, 44
    PUSHBUTTON      "Register Handlers", IDC_BTN_REGISTER_HANDLERS, 20, 24, 100, 14
    PUSHBUTTON      "Restart Explorer",  IDC_BTN_RESTART_EXPLORER, 126, 24, 90, 14
    PUSHBUTTON      "Flush Thumbnails",  IDC_BTN_FLUSH_THUMBCACHE, 222, 24, 100, 14

    LTEXT           "Logman ETW trace session.", -1, 10, 60, 340, 10

    GROUPBOX        "Trace matrix", -1, 10, 74, 340, 72
    LTEXT           "Item",                 -1, 20, 86, 42, 10
    LTEXT           "Error",                -1, 90, 86, 30, 10
    LTEXT           "Warn",                 -1, 138, 86, 28, 10
    LTEXT           "Info",                 -1, 182, 86, 24, 10
    LTEXT           "Verbose",              -1, 222, 86, 40, 10

    LTEXT           "Property",             -1, 20, 100, 50, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PROP_ERROR,   96, 100, 10, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PROP_WARN,    142, 100, 10, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PROP_INFO,    184, 100, 10, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PROP_VERBOSE, 234, 100, 10, 10

    LTEXT           "Preview",              -1, 20, 114, 50, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PREV_ERROR,   96, 114, 10, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PREV_WARN,    142, 114, 10, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PREV_INFO,    184, 114, 10, 10
    AUTOCHECKBOX    "", IDC_CHK_TRACE_PREV_VERBOSE, 234, 114, 10, 10

    PUSHBUTTON      "Start Trace",      IDC_BTN_TRACE_START,      10, 152, 80, 14
    PUSHBUTTON      "Stop Trace",       IDC_BTN_TRACE_STOP,       96, 152, 80, 14
    PUSHBUTTON      "Open ETL",         IDC_BTN_TRACE_OPEN_ETL,  182, 152, 80, 14
    PUSHBUTTON      "Export XML",       IDC_BTN_TRACE_EXPORT_XML,268, 152, 80, 14

    LTEXT           "",                 IDC_STATIC_TRACE_PATH,   10, 176, 340, 24, SS_NOTIFY
    LTEXT           "",                 IDC_STATIC_TRACE_STATUS, 10, 204, 270, 24

    DEFPUSHBUTTON   "Close",           IDOK,                 290, 224, 60, 14
END

#ifdef RC_INVOKED
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    XISF_VERSION_COMMA
 PRODUCTVERSION XISF_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Dennis Payne"
            VALUE "FileDescription",  "XISF Shell Extension Host (about stub)"
            VALUE "FileVersion",      XISF_VERSION_STR
            VALUE "InternalName",     "XISFShellExtensionHost"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Dennis Payne. MIT License."
            VALUE "OriginalFilename", "XISFShellExtensionHost.exe"
            VALUE "ProductName",      "XISF Shell Extension"
            VALUE "ProductVersion",   XISF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif
